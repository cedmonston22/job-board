// Prisma schema for the job-board project.
// See https://pris.ly/d/prisma-schema for syntax docs.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js v5 — database adapter tables
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  jobs     Job[]
  resume   Resume?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain — Jobs you're tracking
// ---------------------------------------------------------------------------

enum JobStatus {
  SAVED
  APPLIED
  REJECTED
}

model Job {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Job content (what the role is)
  title       String
  company     String
  location    String?
  remoteType  String? // "remote" | "hybrid" | "onsite" — free-form for now
  salaryMin   Int? // both null = "salary not listed"
  salaryMax   Int?
  description String? // from the job posting
  url         String?

  // User tracking (what you think about it)
  status     JobStatus @default(SAVED)
  appliedAt  DateTime? // set when status flips to APPLIED
  rejectedAt DateTime? // set when status flips to REJECTED
  notes      String? // your private notes

  // Filled by scrapers in Phase 3 (null for manually-added jobs)
  source   String? // e.g. "greenhouse", "lever", "manual"
  sourceId String? // external ID at the source
  postedAt DateTime?

  // Filled by AI in Phase 4
  fitScore     Int? // 0..100
  fitReasoning String?

  // Filled by AI in Phase 5 (cover-letter generation)
  coverLetter String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]

  // Prevents the scraper from creating duplicate rows for the same posting.
  // Postgres treats NULLs as distinct, so multiple manual entries with
  // source = null are still allowed.
  @@unique([userId, source, sourceId])
  // Fast lookup for "all of my SAVED jobs" / "all of my APPLIED jobs".
  @@index([userId, status])
}

// The user's uploaded resume. One per user (enforced by @unique on userId).
// File bytes live in Vercel Blob; only the URL + metadata sit in Postgres.
// `parsedJson` will be filled in step 2.4 once Groq parsing is wired up.
model Resume {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileUrl      String // Vercel Blob URL (private — see app/api/resume/view/route.ts)
  fileName     String // original filename, e.g. "alex-resume.pdf"
  fileMimeType String // application/pdf | application/vnd...wordprocessingml.document | text/plain
  fileSize     Int // bytes

  // Plain text extracted from the file on upload. Used as the AI input in
  // step 2.4 and downstream by Phase 4/5. Null if extraction failed (e.g.
  // scanned PDF with no text layer).
  extractedText String?

  parsedJson Json? // populated in step 2.4

  uploadedAt DateTime  @default(now())
  parsedAt   DateTime?
}

// People you might reach out to for a given job. Manual entries for now —
// Phase 6 will (maybe) add deep-link-driven discovery from LinkedIn searches.
model Contact {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name        String
  role        String? // their job title at the company
  linkedinUrl String?
  email       String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
}
