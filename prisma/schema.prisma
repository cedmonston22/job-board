// Prisma schema for the job-board project.
// See https://pris.ly/d/prisma-schema for syntax docs.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js v5 — database adapter tables
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts        Account[]
  sessions        Session[]
  jobs            Job[]
  resume          Resume?
  scrapeFilter    ScrapeFilter?
  discoveredJobs  DiscoveredJob[]
  scrapeRuns      ScrapeRun[]

  // Set the first time the user finishes (or skips) onboarding. Null = the
  // user has signed in but hasn't been through the welcome/resume-upload step
  // yet. Used by `lib/require-onboarded.ts` to gate every authed page.
  onboardedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain — Jobs you're tracking
// ---------------------------------------------------------------------------

enum JobStatus {
  SAVED
  APPLIED
  REJECTED
}

model Job {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Job content (what the role is)
  title       String
  company     String
  location    String?
  remoteType  String? // "remote" | "hybrid" | "onsite" — free-form for now
  salaryMin   Int? // both null = "salary not listed"
  salaryMax   Int?
  description String? // from the job posting
  url         String?

  // User tracking (what you think about it)
  status     JobStatus @default(SAVED)
  appliedAt  DateTime? // set when status flips to APPLIED
  rejectedAt DateTime? // set when status flips to REJECTED
  notes      String? // your private notes

  // Filled by scrapers in Phase 3 (null for manually-added jobs)
  source   String? // e.g. "greenhouse", "lever", "manual"
  sourceId String? // external ID at the source
  postedAt DateTime?

  // Filled by AI in Phase 4. Score runs in the background via `after()` once a
  // Job is created (manual add or imported from /jobs/search) — see
  // `lib/fit-scorer.ts`. All four fields are populated atomically: either all
  // are set (success) or all stay null (no resume / Groq failed).
  fitScore     Int? // 0..100
  fitSummary   String? // ~1 sentence, shown as a tooltip on the table cell
  fitStrengths String[] // resume points that match the JD
  fitGaps      String[] // resume gaps relative to the JD
  fitScoredAt  DateTime? // last successful score; null if never scored

  // Filled by AI in Phase 5 (cover-letter generation)
  coverLetter String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]

  // Prevents the scraper from creating duplicate rows for the same posting.
  // Postgres treats NULLs as distinct, so multiple manual entries with
  // source = null are still allowed.
  @@unique([userId, source, sourceId])
  // Fast lookup for "all of my SAVED jobs" / "all of my APPLIED jobs".
  @@index([userId, status])
}

// The user's uploaded resume. One per user (enforced by @unique on userId).
// File bytes live in Vercel Blob; only the URL + metadata sit in Postgres.
// `parsedJson` will be filled in step 2.4 once Groq parsing is wired up.
model Resume {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileUrl      String // Vercel Blob URL (private — see app/api/resume/view/route.ts)
  fileName     String // original filename, e.g. "alex-resume.pdf"
  fileMimeType String // application/pdf | application/vnd...wordprocessingml.document | text/plain
  fileSize     Int // bytes

  // Plain text extracted from the file on upload. Used as the AI input in
  // step 2.4 and downstream by Phase 4/5. Null if extraction failed (e.g.
  // scanned PDF with no text layer).
  extractedText String?

  parsedJson Json? // populated in step 2.4

  uploadedAt DateTime  @default(now())
  parsedAt   DateTime?
}

// People you might reach out to for a given job. Manual entries for now —
// Phase 6 will (maybe) add deep-link-driven discovery from LinkedIn searches.
model Contact {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name        String
  role        String? // their job title at the company
  linkedinUrl String?
  email       String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Phase 3 — Scrapers
// ---------------------------------------------------------------------------

// Which job-board APIs/feeds we know how to scrape. The set of enabled
// sources lives in code (lib/scrapers/default-sources.ts) — no per-user
// config UI. The scraper runner switches on this value to pick the adapter.
enum ScrapeSourceType {
  GREENHOUSE        // boards-api.greenhouse.io/v1/boards/{slug}/jobs
  LEVER             // api.lever.co/v0/postings/{slug}
  ASHBY             // api.ashbyhq.com/posting-api/job-board/{slug}
  WORKDAY           // {tenant}.wd{N}.myworkdayjobs.com/wday/cxs/{tenant}/{site}/jobs
  REMOTEOK          // remoteok.com/api (global firehose; identifier ignored)
  SIMPLIFY_SUMMER   // github.com/SimplifyJobs/Summer2026-Internships README.md
  SIMPLIFY_NEWGRAD  // github.com/SimplifyJobs/New-Grad-Positions README.md
  OUCKAH_SUMMER     // github.com/Ouckah/Summer2026-Internships README.md
}

// One row per user. Applied at scrape time to drop irrelevant titles before
// they ever hit the database. Empty config = save everything.
//
// Filter precedence (see lib/scrapers/filter.ts):
//   1. If `roles` is non-empty → keep jobs whose title contains any role
//   2. Else if `major` is set → look up keywords from MAJOR_KEYWORDS
//   3. Else → keep everything
model ScrapeFilter {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  major String?  // dropdown value, e.g. "Computer Science"; null = no umbrella
  roles String[] // specific titles override, e.g. ["data engineer", "ml engineer"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The scraper output pool. Separate from `Job` so the user can browse and
// triage discovered postings without polluting their tracked list. Clicking
// "Import" copies the row into Job with status=SAVED and stamps
// `importedJobId` here so the search tab can hide it.
model DiscoveredJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source   ScrapeSourceType
  sourceId String           // external id, or hash of URL for repo sources

  title       String
  company     String
  location    String?  // displayed as a column on the search tab
  url         String
  description String?  // some adapters provide, others don't
  postedAt    DateTime?

  discoveredAt DateTime @default(now())

  // User actions on a discovered job. importedJobId links to the new Job row
  // created by "Import"; dismissedAt is set by "Not interested".
  importedJobId String?
  dismissedAt   DateTime?

  // Scrapers re-run daily — the unique constraint makes upsert idempotent.
  @@unique([userId, source, sourceId])
  // Fast lookup for "show me undismissed, unimported leads".
  @@index([userId, dismissedAt, importedJobId])
}

// Audit row for every scrape invocation (cron + manual). The cron route
// hits `/api/cron/scrape` daily at 11:00 UTC and iterates users; the
// `/api/scrape/run` manual endpoint targets a single user. Both write a
// ScrapeRun so we can see at a glance whether the scheduled run actually
// fired and what it produced — without this, a silent 401 on the cron
// (e.g. CRON_SECRET unset on Vercel) is invisible until a user notices
// stale data.
//
// Aggregate counts here, per-source detail in the JSON column. The detail
// matches the RunSummary shape (see lib/scrapers/types.ts).
enum ScrapeTrigger {
  CRON
  MANUAL
}

model ScrapeRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trigger     ScrapeTrigger
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  // Top-level success/failure. `ok = false` means the run itself threw
  // (DB error, network catastrophe). Per-source errors don't flip this —
  // they're captured in `sourcesErrored` + the JSON breakdown.
  ok           Boolean @default(false)
  errorMessage String?

  // Aggregated counters across all sources for this run.
  pruned         Int @default(0)
  fetched        Int @default(0)
  kept           Int @default(0)
  inserted       Int @default(0)
  updated        Int @default(0)
  sourcesOk      Int @default(0)
  sourcesErrored Int @default(0)

  // Per-source breakdown — array of { source, label, fetched, kept,
  // inserted, updated, errored }. JSON because the shape is read-only
  // for display and we don't want to model 15 rows per run as a separate
  // table.
  sources Json?

  // Fast "most recent run for this user" lookup — primary use case is the
  // status pill on /jobs/search. startedAt DESC.
  @@index([userId, startedAt])
}
